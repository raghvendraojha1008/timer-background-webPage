{
  "appId": "com.liveclock.wallpaper",
  "productName": "Live Clock Wallpaper",
  "directories": {
    "buildResources": "electron/resources",
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      },
      {
        "target": "appx",
        "arch": ["x64"]
      }
    ],
    "icon": "electron/resources/icon.ico",
    "publisherName": "YourName",
    "verifyUpdateCodeSignature": false
  },
  "appx": {
    "backgroundColor": "#1a1a2e",
    "displayName": "Live Clock Wallpaper",
    "identityName": "YourCompany.LiveClockWallpaper",
    "publisher": "CN=YourPublisher",
    "publisherDisplayName": "Your Name",
    "applicationId": "LiveClockWallpaper",
    "languages": ["en-US"],
    "addAutoLaunchExtension": true,
    "showNameOnTiles": true,
    "setBuildNumber": true
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Live Clock Wallpaper",
    "runAfterFinish": true
  },
  "publish": {
    "provider": "generic",
    "url": "https://your-update-server.com"
  }
}
